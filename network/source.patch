+BOOST_FIXTURE_TEST_SUITE(vaytria_tests, BasicTestingSetup)
+
+BOOST_AUTO_TEST_CASE(independent_network_and_valid_genesis)
+{
+    const auto vaytria = CChainParams::Vaytria();
+    const auto bitcoin = CChainParams::Main();
+    BOOST_CHECK(vaytria->GetChainType() == ChainType::VAYTRIA);
+    BOOST_CHECK_EQUAL(vaytria->GetChainTypeString(), "vaytria");
+    BOOST_CHECK(!vaytria->IsTestChain());
+    BOOST_CHECK(vaytria->GenesisBlock().GetHash() != bitcoin->GenesisBlock().GetHash());
+    BOOST_CHECK_EQUAL(vaytria->GenesisBlock().GetHash().ToString(), "00000000c59f648b04817dd53eb907d6ab78dfef3cf35a6c4e4bbca3cac3af22");
+    BOOST_CHECK(vaytria->GenesisBlock().GetHash() != uint256{"00000000f2301dd76f7a601e7761be5011b4bc9bf69f24e6db7d962f98874a65"});
+    BOOST_CHECK(vaytria->GenesisBlock().hashPrevBlock.IsNull());
+    BOOST_CHECK(CheckProofOfWork(vaytria->GenesisBlock().GetHash(), vaytria->GenesisBlock().nBits, vaytria->GetConsensus()));
+    BOOST_CHECK_EQUAL(vaytria->GenesisBlock().nBits, bitcoin->GenesisBlock().nBits);
+    BOOST_CHECK(vaytria->GenesisBlock().vtx[0]->vout[0].scriptPubKey.IsUnspendable());
+    BOOST_CHECK(vaytria->DNSSeeds().empty());
+    BOOST_CHECK(vaytria->FixedSeeds().empty());
+    BOOST_CHECK(vaytria->GetAvailableSnapshotHeights().empty());
+    BOOST_CHECK(vaytria->GetConsensus().nMinimumChainWork.IsNull());
+    BOOST_CHECK(vaytria->GetConsensus().defaultAssumeValid.IsNull());
+    BOOST_CHECK(vaytria->GetConsensus().script_flag_exceptions.empty());
+    BOOST_CHECK(vaytria->GetConsensus().BIP34Hash.IsNull());
+    for (const auto& other : {CChainParams::Main(), CChainParams::TestNet(), CChainParams::TestNet4(), CChainParams::SigNet({}), CChainParams::RegTest({})}) {
+        BOOST_CHECK(vaytria->MessageStart() != other->MessageStart());
+        BOOST_CHECK(vaytria->GetDefaultPort() != other->GetDefaultPort());
+        BOOST_CHECK(vaytria->Bech32HRP() != other->Bech32HRP());
+    }
+    BOOST_CHECK(GetNetworkForMagic(vaytria->MessageStart()) == ChainType::VAYTRIA);
+}
+
+BOOST_AUTO_TEST_CASE(bitcoin_monetary_and_difficulty_rules)
+{
+    const auto vaytria = CChainParams::Vaytria();
+    const auto bitcoin = CChainParams::Main();
+    const auto& v = vaytria->GetConsensus();
+    const auto& b = bitcoin->GetConsensus();
+    BOOST_CHECK_EQUAL(v.nSubsidyHalvingInterval, 210000);
+    BOOST_CHECK_EQUAL(v.nPowTargetSpacing, 600);
+    BOOST_CHECK_EQUAL(v.nPowTargetTimespan, 14 * 24 * 60 * 60);
+    BOOST_CHECK(v.powLimit == b.powLimit);
+    BOOST_CHECK(!v.fPowAllowMinDifficultyBlocks);
+    BOOST_CHECK(!v.fPowNoRetargeting);
+    BOOST_CHECK_EQUAL(v.nPowTargetTimespan / v.nPowTargetSpacing, 2016);
+    CAmount issued{0};
+    for (int halving = 0; halving < 64; ++halving) {
+        const int height = halving * 210000;
+        const CAmount reward = GetBlockSubsidy(height, v);
+        BOOST_CHECK_EQUAL(reward, GetBlockSubsidy(height, b));
+        BOOST_CHECK_EQUAL(GetBlockSubsidy(height + 209999, v), reward);
+        issued += reward * 210000;
+        BOOST_CHECK(MoneyRange(issued));
+    }
+    BOOST_CHECK_EQUAL(issued, CAmount{2099999997690000});
+    BOOST_CHECK_EQUAL(GetBlockSubsidy(64 * 210000, v), 0);
+    BOOST_CHECK_EQUAL(MAX_MONEY, 21000000 * COIN);
+}
+
+BOOST_AUTO_TEST_CASE(addresses_and_default_chain_are_separate)
+{
+    ArgsManager args;
+    BOOST_CHECK(args.GetChainType() == ChainType::VAYTRIA);
+    BOOST_CHECK(ChainTypeFromString("vaytria") == ChainType::VAYTRIA);
+    BOOST_CHECK_EQUAL(CreateBaseChainParams(ChainType::VAYTRIA)->RPCPort(), 31443);
+    const std::string bitcoin_address{"1BoatSLRHtKNngkdXEeobR76b53LETtpyT"};
+    SelectParams(ChainType::MAIN);
+    const auto destination = DecodeDestination(bitcoin_address);
+    BOOST_REQUIRE(IsValidDestination(destination));
+    SelectParams(ChainType::VAYTRIA);
+    BOOST_CHECK(!IsValidDestinationString(bitcoin_address));
+    const auto vaytria_address = EncodeDestination(destination);
+    BOOST_CHECK(IsValidDestinationString(vaytria_address));
+    BOOST_CHECK(vaytria_address != bitcoin_address);
+    BOOST_CHECK_EQUAL(Params().Bech32HRP(), "vtr");
+    SelectParams(ChainType::MAIN);
+    BOOST_CHECK(!IsValidDestinationString(vaytria_address));
+}
+
+BOOST_AUTO_TEST_CASE(current_transaction_rules_are_active_from_start)
